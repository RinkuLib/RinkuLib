<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <DataTemplate.Resources>
        <Thickness x:Key="DialogInset">12</Thickness>
        <Thickness x:Key="FieldGroupGap">0,0,0,12</Thickness>
        <Thickness x:Key="LabelGap">0,0,0,5</Thickness>
        <Thickness x:Key="ControlInset">6,4</Thickness>
        <Thickness x:Key="ButtonInset">12,4</Thickness>
        <Thickness x:Key="ButtonGap">6,0,0,0</Thickness>
        <Thickness x:Key="ColumnGap">6,0</Thickness>
        <Thickness x:Key="FooterGap">0,12,0,0</Thickness>
    </DataTemplate.Resources>
    <Border MinWidth="840" MinHeight="480" MaxHeight="720" Background="{DynamicResource {x:Static styles:VsBrushes.WindowKey}}" Padding="{StaticResource DialogInset}">

        <Grid TextElement.Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}">
            <Grid.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogButtonStyleKey}}">
                    <Setter Property="Padding" Value="{StaticResource ButtonInset}" />
                    <Setter Property="Margin" Value="{StaticResource ButtonGap}" />
                </Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogTextBoxStyleKey}}">
                    <Setter Property="Padding" Value="{StaticResource ControlInset}" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogComboBoxStyleKey}}">
                    <Setter Property="Padding" Value="{StaticResource ControlInset}" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogCheckBoxStyleKey}}" />
                <Style TargetType="Label" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogLabelStyleKey}}">
                    <Setter Property="Padding" Value="{StaticResource LabelGap}" />
                </Style>
                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogListBoxStyleKey}}" />
                <Style x:Key="FieldGroup" TargetType="StackPanel">
                    <Setter Property="Margin" Value="{StaticResource FieldGroupGap}" />
                </Style>
                <Style x:Key="ValidationMessage" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowValidationErrorTextBrushKey}}" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox Margin="{StaticResource FieldGroupGap}" Grid.Row="0" Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Margin="{StaticResource FieldGroupGap}" Grid.Row="1" Content="{Binding NewText}" Command="{Binding NewCommand}" />
                <ListBox Grid.Row="2" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding FilteredItems}" SelectedIndex="{Binding DisplayIndex, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Label Content="{Binding Description}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <GridSplitter Margin="{StaticResource ColumnGap}" Grid.Column="1" MinWidth="{DynamicResource {x:Static SystemParameters.ResizeFrameVerticalBorderWidthKey}}" HorizontalAlignment="Stretch" Background="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}"/>
            <Grid Grid.Column="2">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWorkspaceVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    {{CONTENT}}
                </ScrollViewer>
                
                <Border Margin="{StaticResource FooterGap}" Grid.Row="1" BorderBrush="{DynamicResource {x:Static colors:EnvironmentColors.ToolWindowBorderBrushKey}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{Binding DeleteText}" 
                                Command="{Binding DeleteCommand}" Visibility="{Binding DeleteVisible}" />
                        <Button Grid.Column="2" Content="{Binding CommitText}" 
                                Command="{Binding CommitCommand}" IsEnabled="{Binding IsCommitEnabled}" />
                        <Button Grid.Column="3" Content="{Binding CancelText}" 
                                Command="{Binding CancelCommand}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</DataTemplate>
