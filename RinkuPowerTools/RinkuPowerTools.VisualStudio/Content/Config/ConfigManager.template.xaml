<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">
    <StackPanel Orientation="Vertical">
        <StackPanel Style="{StaticResource FieldGroup}">
            <Label Content="Config Name" FontWeight="SemiBold"/>
            <TextBox Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNewWorkspace}" />
            <TextBlock Text="{Binding NameError}" Style="{StaticResource ValidationMessage}" />
        </StackPanel>
        <StackPanel Style="{StaticResource FieldGroup}">
            <CheckBox IsChecked="{Binding EditIsInternal, Mode=TwoWay}"
                      Content="Class is internal" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Style="{StaticResource FieldGroup}">
            <Label Content="Database" FontWeight="SemiBold"/>
            <ComboBox SelectedValue="{Binding EditDatabase, Mode=TwoWay}"
                      SelectedValuePath="Database"
                      DisplayMemberPath="DisplayName"
                      ItemsSource="{Binding AvailableDatabases}"/>
        </StackPanel>
        <StackPanel Style="{StaticResource FieldGroup}">
            <Label Content="Connection Source" FontWeight="SemiBold"/>
            <ComboBox SelectedValue="{Binding SelectedSource, Mode=TwoWay}"
                      SelectedValuePath="Value" DisplayMemberPath="Description"
                      ItemsSource="{Binding AvailableSources}"/>
        </StackPanel>
        <StackPanel Style="{StaticResource FieldGroup}">
            <Label Content="{Binding SelectedSource.TargetLabel}" FontWeight="SemiBold"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding EditTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseCommand}" Visibility="{Binding IsBrowseVisible}" />
            </Grid>
            <TextBlock Text="{Binding TargetError}" Style="{StaticResource ValidationMessage}" />
        </StackPanel>
        <StackPanel Style="{StaticResource FieldGroup}" Visibility="{Binding IsExtractionPathVisible}">
            <Label Content="{Binding SelectedSource.ExtractionPathLabel}" FontWeight="SemiBold"/>
            <TextBox Text="{Binding EditExtractionPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="{Binding ExtractionPathError}" Style="{StaticResource ValidationMessage}" />
        </StackPanel>

        <Grid Margin="{StaticResource FieldGroupGap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Margin="0" Content="Show Connection String" Command="{Binding ShowConnectionStringCommand}"/>
            <Button Grid.Column="1" Content="Test Connection" Command="{Binding TestConnectionCommand}" />
        </Grid>
        <StackPanel Style="{StaticResource FieldGroup}">
            <Label Content="Output Path" FontWeight="SemiBold"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding EditOutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseFolderCommand}"/>
            </Grid>
        </StackPanel>
        <StackPanel Style="{StaticResource FieldGroup}">
            <Label Content="Namespace (optional)" FontWeight="SemiBold"/>
            <TextBox Text="{Binding EditNamespace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Style="{StaticResource FieldGroup}">
            <Label ToolTip="SQL NULL Value creates a container; parent paths create missing containers. Return five string columns: Name, Value, Type, Description, Parent." Content="Constants / enums (optional)" FontWeight="SemiBold"/>
            <ComboBox Margin="{StaticResource FieldGroupGap}" SelectedValue="{Binding EditConstantsType, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Description" ItemsSource="{Binding ConstantsTypes}"/>
            <StackPanel Visibility="{Binding ConstantsVisibility}">
                <TextBox Visibility="{Binding ConstantsTextVisibility}" Text="{Binding EditConstantsTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinLines="4" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                <TextBox Visibility="{Binding ConstantsProcedureVisibility}" Text="{Binding EditConstantsTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Grid Visibility="{Binding ConstantsFileVisibility}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding EditConstantsTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseConstantsCommand}"/>
                </Grid>
            </StackPanel>
            <TextBlock Text="{Binding ConstantsError}" Style="{StaticResource ValidationMessage}"/>
        </StackPanel>
    </StackPanel>
</DataTemplate>
