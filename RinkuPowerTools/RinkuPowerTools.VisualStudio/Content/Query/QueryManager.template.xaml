<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <StackPanel Orientation="Vertical">
        <StackPanel Style="{StaticResource FieldGroup}">
            <Label Content="Method Name" FontWeight="SemiBold"/>
            <TextBox Text="{Binding EditMethodName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="{Binding MethodNameError}" Style="{StaticResource ValidationMessage}" />
        </StackPanel>

        <StackPanel Style="{StaticResource FieldGroup}">
            <Label Content="Command Type" FontWeight="SemiBold"/>
            <ComboBox SelectedValue="{Binding EditTargetType, Mode=TwoWay}"
                  SelectedValuePath="Value" DisplayMemberPath="Description"
                  ItemsSource="{Binding TargetTypeValues}"/>
        </StackPanel>

        <StackPanel Style="{StaticResource FieldGroup}">
            <Label Content="{Binding TargetLabel}" FontWeight="SemiBold" />

            <TextBox Visibility="{Binding TextModeVisibility}" Text="{Binding EditTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinLines="4" AcceptsReturn="True" TextWrapping="Wrap" AcceptsTab="True" VerticalScrollBarVisibility="Auto" />

            <ComboBox Visibility="{Binding StoredProcedureModeVisibility}"
                    Text="{Binding EditTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ItemsSource="{Binding StoredProcedureSuggestions}"
                    SelectedValuePath="Value" DisplayMemberPath="Description"/>

            <Grid Visibility="{Binding FileModeVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding EditTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseSQLFileCommand}"/>
            </Grid>
            <TextBlock Text="{Binding TargetError}" Style="{StaticResource ValidationMessage}" />
        </StackPanel>

        <StackPanel Style="{StaticResource FieldGroup}">
            <Label Content="Result set name (optional)" FontWeight="SemiBold"/>
            <TextBox Text="{Binding EditResultSetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Style="{StaticResource FieldGroup}">
            <CheckBox Content="Generate before/after hooks" IsChecked="{Binding EditGenerateHooks, Mode=TwoWay}"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Parameter corrections (optional)" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="+ Add correction" Command="{Binding AddParameterCommand}"/>
        </Grid>

        <StackPanel Margin="{StaticResource FooterGap}" Grid.IsSharedSizeScope="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ParameterType" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ParameterNullable" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ParameterAction" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Parameter name" FontWeight="SemiBold" />
                <Label Grid.Column="1" Content="SQL type" FontWeight="SemiBold" Margin="{StaticResource ColumnGap}" />
                <Label Grid.Column="2" Content="Default" FontWeight="SemiBold" Margin="{StaticResource ColumnGap}" ToolTip="Optional C# default expression, such as null, true, 10 or a quoted string. Leave blank to keep the argument required." />
                <Label Grid.Column="3" Content="Nullable" FontWeight="SemiBold" HorizontalAlignment="Center" />
            </Grid>
            <ItemsControl ItemsSource="{Binding EditParameters}" HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="{StaticResource FieldGroupGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ParameterType" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ParameterNullable" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ParameterAction" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" VerticalAlignment="Stretch" />
                            <ComboBox Grid.Column="1" Margin="{StaticResource ColumnGap}" IsEditable="True" IsReadOnly="False" VerticalContentAlignment="Center" VerticalAlignment="Stretch"
                                      Text="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding DataContext.ParameterTypeSuggestions, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            <TextBox Grid.Column="2" Margin="{StaticResource ColumnGap}" Text="{Binding DefaultValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Stretch" ToolTip="C# expression. Blank means required; null means an optional null default." />
                            <CheckBox Grid.Column="3" IsChecked="{Binding IsNullable, Mode=TwoWay}" IsThreeState="True" VerticalAlignment="Center" HorizontalAlignment="Center"
                                      ToolTip="Indeterminate uses SQL discovery; checked permits NULL; unchecked disallows NULL." />
                            <Button Grid.Column="4" Content="Remove" VerticalAlignment="Stretch" Command="{Binding DataContext.DeleteParameterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</DataTemplate>
