{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "RinkuLib/RinkuLib.csproj"
          ]
        }
      ],
      "dest": "api/rinku",
      "outputFormat": "mref",
      "properties": {
        "TargetFramework": "net10.0",
        "DocsApiBuild": "true"
      }
    },
    {
      "src": [
        {
          "src": "..",
          "files": [
            "Rinku.More/Rinku.More/Rinku.More.csproj"
          ]
        }
      ],
      "dest": "api/rinku-more",
      "outputFormat": "mref",
      "properties": {
        "TargetFramework": "net10.0",
        "DocsApiBuild": "true"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/index.md",
          "api/toc.yml",
          "api/rinku/index.md",
          "api/rinku/**.yml"
        ],
        "exclude": [
          "api/rinku/toc.yml"
        ]
      },
      {
        "files": [
          "api/rinku-more/index.md",
          "api/rinku-more/**.yml"
        ],
        "exclude": [
          "api/rinku-more/toc.yml",
          "api/rinku-more/Rinku.yml"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "index.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "markdownEngineProperties": {
      "markdigExtensions": [
        "attributes"
      ]
    },
    "template": [
      "default",
      "modern",
      "templates/rinku"
    ],
    "globalMetadata": {
      "_appName": "RinkuLib",
      "_appTitle": "RinkuLib Documentation",
      "_appLogoPath": "images/logo.svg",
      "_appFaviconPath": "images/favicon.ico",
      "_enableSearch": true,
      "_disableContribution": false
    }
  }
}
